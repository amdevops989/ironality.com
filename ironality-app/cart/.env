# --------------------
# Server
# --------------------
PORT=3003
LOG_LEVEL=info
OTEL_PROM_PORT=9466

#
# --------------------
# PostgreSQL (App & Debezium)
# --------------------
# App user (catalog service)
PGUSER=appuser
PGPASSWORD=appuser
PGHOST=localhost
PGPORT=5432
PGDATABASE=mv100db

# Debezium / replication user
DBZ_USER=dbz
DBZ_PASSWORD=dbz

# --------------------
# Redis
# --------------------
REDIS_URL=redis://localhost:6379

# --------------------
# Kafka (local KRaft mode)
# --------------------
KAFKA_CLIENT_ID=cart-service
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC_ORDERS=mv100db.public.orders

# --------------------
# Debezium (Postgres CDC)
# --------------------
JWT_SECRET=superToken
FRONTEND_URL=http://localhost