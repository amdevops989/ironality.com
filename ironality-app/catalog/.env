# --------------------
# Server
# --------------------
PORT=3001
LOG_LEVEL=info

# --------------------
# PostgreSQL (App & Debezium)
# --------------------
# App user (catalog service)
PGUSER=appuser
PGPASSWORD=appuser
PGHOST=localhost
PGPORT=5432
PGDATABASE=mv100db

# Debezium / replication user
DBZ_USER=dbz
DBZ_PASSWORD=dbz

# --------------------
# Redis
# --------------------
REDIS_URL=redis://localhost:6379

# --------------------
# Kafka (local KRaft mode)
# --------------------
KAFKA_CLIENT_ID=catalog-service
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC_PRODUCTS=mv100db.public.products

# --------------------
# Debezium (Postgres CDC)
# --------------------
DEBEZIUM_CONNECT_URL=http://localhost:8083
DEBEZIUM_TOPIC_PREFIX=mv100db
DEBEZIUM_TABLES=public.users,public.orders,public.payments,public.emails,public.products
DEBEZIUM_SLOT=dbz_slot
DEBEZIUM_PUBLICATION=dbz_pub
DEBEZIUM_HISTORY_TOPIC=schema-changes.mv100db
